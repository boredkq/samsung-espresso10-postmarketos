From: Nikola <nikola@postmarketos.org>
Subject: [PATCH] ASoC: ti: add Samsung espresso10 machine driver

The WM1811 needs FLL1 configured from the board's 26 MHz MCLK before
AIF1 can transfer audio.  simple-audio-card cannot describe that clock
sequence, so provide the small board machine driver used by espresso10.

---
 sound/soc/ti/Kconfig   |  10 +++
 sound/soc/ti/Makefile  |   2 +
 sound/soc/ti/espresso.c | 162 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 174 insertions(+)

diff --git a/sound/soc/ti/Kconfig b/sound/soc/ti/Kconfig
--- a/sound/soc/ti/Kconfig
+++ b/sound/soc/ti/Kconfig
@@ -66,5 +66,15 @@
 
 comment "Audio support for boards with Texas Instruments SoCs"
+config SND_SOC_SAMSUNG_ESPRESSO
+	tristate "SoC Audio support for Samsung Galaxy Tab 2"
+	depends on ARCH_OMAP4 && I2C
+	depends on MFD_WM8994
+	select SND_SOC_OMAP_MCBSP
+	select SND_SOC_WM8994
+	help
+	  Say Y or M to enable WM1811 audio on Samsung Galaxy Tab 2
+	  espresso10 tablets.
+
 config SND_SOC_NOKIA_N810
 	tristate "SoC Audio support for Nokia N810"
 	depends on MACH_NOKIA_N810 && I2C
diff --git a/sound/soc/ti/Makefile b/sound/soc/ti/Makefile
--- a/sound/soc/ti/Makefile
+++ b/sound/soc/ti/Makefile
@@ -25,6 +25,7 @@ obj-$(CONFIG_SND_SOC_OMAP_MCPDM) += snd-soc-omap-mcpdm.o
 # Machine drivers
 snd-soc-davinci-evm-y := davinci-evm.o
 snd-soc-n810-y := n810.o
+snd-soc-espresso-y := espresso.o
 snd-soc-rx51-y := rx51.o
 snd-soc-omap3pandora-y := omap3pandora.o
 snd-soc-omap-twl4030-y := omap-twl4030.o
@@ -36,6 +37,7 @@ snd-soc-j721e-evm-y := j721e-evm.o
 
 obj-$(CONFIG_SND_SOC_DAVINCI_EVM) += snd-soc-davinci-evm.o
 obj-$(CONFIG_SND_SOC_NOKIA_N810) += snd-soc-n810.o
+obj-$(CONFIG_SND_SOC_SAMSUNG_ESPRESSO) += snd-soc-espresso.o
 obj-$(CONFIG_SND_SOC_NOKIA_RX51) += snd-soc-rx51.o
 obj-$(CONFIG_SND_SOC_OMAP3_PANDORA) += snd-soc-omap3pandora.o
 obj-$(CONFIG_SND_SOC_OMAP3_TWL4030) += snd-soc-omap-twl4030.o
diff --git a/sound/soc/ti/espresso.c b/sound/soc/ti/espresso.c
new file mode 100644
--- /dev/null
+++ b/sound/soc/ti/espresso.c
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* ASoC machine driver for Samsung Galaxy Tab 2 (espresso10). */
+
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+
+#include "../codecs/wm8994.h"
+
+#define ESPRESSO_MCLK_RATE 26000000
+
+struct espresso_audio {
+	struct gpio_desc *main_mic_bias;
+};
+
+static int espresso_main_mic_event(struct snd_soc_dapm_widget *widget,
+				   struct snd_kcontrol *control, int event)
+{
+	struct snd_soc_card *card = snd_soc_dapm_to_card(widget->dapm);
+	struct espresso_audio *priv = snd_soc_card_get_drvdata(card);
+
+	if (priv->main_mic_bias)
+		gpiod_set_value_cansleep(priv->main_mic_bias,
+					  SND_SOC_DAPM_EVENT_ON(event));
+
+	return 0;
+}
+
+static int espresso_hw_params(struct snd_pcm_substream *substream,
+			      struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+	unsigned int sysclk = params_rate(params) * 256;
+	int ret;
+
+	ret = snd_soc_dai_set_pll(codec_dai, WM8994_FLL1,
+				  WM8994_FLL_SRC_MCLK1,
+				  ESPRESSO_MCLK_RATE, sysclk);
+	if (ret) {
+		dev_err(rtd->dev, "failed to configure WM1811 FLL1: %d\n", ret);
+		return ret;
+	}
+
+	ret = snd_soc_dai_set_sysclk(codec_dai, WM8994_SYSCLK_FLL1,
+				     sysclk, SND_SOC_CLOCK_IN);
+	if (ret)
+		dev_err(rtd->dev, "failed to select WM1811 FLL1: %d\n", ret);
+
+	return ret;
+}
+
+static const struct snd_soc_ops espresso_ops = {
+	.hw_params = espresso_hw_params,
+};
+
+static const struct snd_soc_dapm_widget espresso_widgets[] = {
+	SND_SOC_DAPM_SPK("Speaker", NULL),
+	SND_SOC_DAPM_HP("Headphone Jack", NULL),
+	SND_SOC_DAPM_MIC("Main Mic", espresso_main_mic_event),
+};
+
+static const struct snd_soc_dapm_route espresso_routes[] = {
+	{ "Speaker", NULL, "SPKOUTLN" },
+	{ "Speaker", NULL, "SPKOUTLP" },
+	{ "Speaker", NULL, "SPKOUTRN" },
+	{ "Speaker", NULL, "SPKOUTRP" },
+	{ "Headphone Jack", NULL, "HPOUT1L" },
+	{ "Headphone Jack", NULL, "HPOUT1R" },
+	{ "IN1LP", NULL, "Main Mic" },
+	{ "IN1LN", NULL, "Main Mic" },
+};
+
+SND_SOC_DAILINK_DEFS(hifi,
+	DAILINK_COMP_ARRAY(COMP_EMPTY()),
+	DAILINK_COMP_ARRAY(COMP_CODEC(NULL, "wm8994-aif1")),
+	DAILINK_COMP_ARRAY(COMP_EMPTY()));
+
+static struct snd_soc_dai_link espresso_dai = {
+	.name = "WM1811 AIF1",
+	.stream_name = "HiFi",
+	.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF |
+		   SND_SOC_DAIFMT_CBP_CFP,
+	.ops = &espresso_ops,
+	SND_SOC_DAILINK_REG(hifi),
+};
+
+static struct snd_soc_card espresso_card = {
+	.name = "espresso10-sound",
+	.owner = THIS_MODULE,
+	.dai_link = &espresso_dai,
+	.num_links = 1,
+	.dapm_widgets = espresso_widgets,
+	.num_dapm_widgets = ARRAY_SIZE(espresso_widgets),
+	.dapm_routes = espresso_routes,
+	.num_dapm_routes = ARRAY_SIZE(espresso_routes),
+	.fully_routed = true,
+};
+
+static int espresso_audio_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct device_node *cpu_np, *codec_np;
+	struct espresso_audio *priv;
+	int ret;
+
+	cpu_np = of_parse_phandle(np, "samsung,cpu-dai", 0);
+	codec_np = of_parse_phandle(np, "samsung,audio-codec", 0);
+	if (!cpu_np || !codec_np) {
+		dev_err(&pdev->dev, "missing CPU DAI or audio codec phandle\n");
+		of_node_put(cpu_np);
+		of_node_put(codec_np);
+		return -EINVAL;
+	}
+
+	espresso_dai.cpus->of_node = cpu_np;
+	espresso_dai.platforms->of_node = cpu_np;
+	espresso_dai.codecs->of_node = codec_np;
+
+	priv = devm_kzalloc(&pdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->main_mic_bias = devm_gpiod_get_optional(&pdev->dev,
+						       "main-mic-bias",
+						       GPIOD_OUT_LOW);
+	if (IS_ERR(priv->main_mic_bias))
+		return dev_err_probe(&pdev->dev, PTR_ERR(priv->main_mic_bias),
+				     "failed to get microphone bias GPIO\n");
+
+	espresso_card.dev = &pdev->dev;
+	snd_soc_card_set_drvdata(&espresso_card, priv);
+
+	ret = devm_snd_soc_register_card(&pdev->dev, &espresso_card);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "failed to register sound card\n");
+
+	return 0;
+}
+
+static const struct of_device_id espresso_audio_of_match[] = {
+	{ .compatible = "samsung,espresso10-audio" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, espresso_audio_of_match);
+
+static struct platform_driver espresso_audio_driver = {
+	.probe = espresso_audio_probe,
+	.driver = {
+		.name = "espresso10-audio",
+		.of_match_table = espresso_audio_of_match,
+	},
+};
+module_platform_driver(espresso_audio_driver);
+
+MODULE_AUTHOR("Nikola");
+MODULE_DESCRIPTION("ASoC machine driver for Samsung Galaxy Tab 2 espresso10");
+MODULE_LICENSE("GPL");
