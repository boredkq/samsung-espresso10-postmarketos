From 7d4982103f1b4a2e5d9c71a3e819b02a9b31d4e1 Mon Sep 17 00:00:00 2001
From: Nikola <nikola@postmarketos.org>
Date: Thu, 10 Sep 2026 14:00:00 +0300
Subject: [PATCH] ARM: dts: omap4-espresso: add Wolfson WM1811 audio and McBSP3

Add support for the Wolfson Microelectronics WM1811 audio codec on
Samsung Galaxy Tab 2 (espresso). The codec is connected to I2C1 at
address 0x1a and uses McBSP3 (remuxed from ABE PDM pins) for the
primary digital audio interface (AIF1).

Add the machine-driver sound node binding McBSP3 and WM1811, the codec
supplies, the 26 MHz clock request and the board microphone-bias GPIO.

Signed-off-by: Nikola <nikola@postmarketos.org>
---
 arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi | 85 ++++++++++++++++++
 1 file changed, 85 insertions(+)

diff --git a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi
index 4d55c0c..53e333a 100644
--- a/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi
+++ b/arch/arm/boot/dts/ti/omap/omap4-samsung-espresso-common.dtsi
@@ -163,6 +163,37 @@
 		regulator-boot-on;
 	};
 
+	reg_vbatt: regulator-vbatt {
+		compatible = "regulator-fixed";
+		regulator-name = "vbatt";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	reg_codec_clk: regulator-codec-clk {
+		compatible = "regulator-fixed";
+		regulator-name = "codec_clk_req";
+		pinctrl-names = "default";
+		pinctrl-0 = <&codec_clk_pins>;
+		gpios = <&gpio4 5 GPIO_ACTIVE_HIGH>; /* GPIO 101: 26M_EN / CODEC_CLK_REQ */
+		startup-delay-us = <10000>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	sound {
+		compatible = "samsung,espresso10-audio";
+		samsung,cpu-dai = <&mcbsp3>;
+		samsung,audio-codec = <&wm1811>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&main_mic_bias_pins>;
+		main-mic-bias-gpios = <&gpio2 16 GPIO_ACTIVE_HIGH>; /* GPIO 48 */
+	};
+
 	pwm10: pwm-10 {
 		pinctrl-names = "default";
 		pinctrl-0 = <&pwm10_default>;
@@ -515,6 +546,33 @@
 			/* cam_shutter.gpio_81 - WLAN_HOST_WAKE */
 		>;
 	};
+
+	mcbsp3_pins: pinmux-mcbsp3-pins {
+		pinctrl-single,pins = <
+			OMAP4_IOPAD(0x104, PIN_INPUT | MUX_MODE1)   /* abe_pdm_ul_data.abe_mcbsp3_dr - AP_I2S_DIN */
+			OMAP4_IOPAD(0x106, PIN_OUTPUT | MUX_MODE1)  /* abe_pdm_dl_data.abe_mcbsp3_dx - AP_I2S_DOUT */
+			OMAP4_IOPAD(0x108, PIN_INPUT | MUX_MODE1)   /* abe_pdm_frame.abe_mcbsp3_clkx - AP_I2S_CLK */
+			OMAP4_IOPAD(0x10a, PIN_INPUT | MUX_MODE1)   /* abe_pdm_lb_clk.abe_mcbsp3_fsx - AP_I2S_SYNC */
+		>;
+	};
+
+	codec_pins: pinmux-codec-pins {
+		pinctrl-single,pins = <
+			OMAP4_IOPAD(0x06a, PIN_OUTPUT | MUX_MODE3)  /* gpmc_a21.gpio_45 - CODEC_LDO_EN */
+		>;
+	};
+
+	codec_clk_pins: pinmux-codec-clk-pins {
+		pinctrl-single,pins = <
+			OMAP4_IOPAD(0x090, PIN_OUTPUT | MUX_MODE3)  /* gpmc_ncs4.gpio_101 - CODEC_CLK_REQ (26M_EN) */
+		>;
+	};
+
+	main_mic_bias_pins: pinmux-main-mic-bias-pins {
+		pinctrl-single,pins = <
+			OMAP4_IOPAD(0x070, PIN_OUTPUT | MUX_MODE3)  /* gpmc_a24.gpio_48 - MICBIAS_EN */
+		>;
+	};
 };
 
 &uart3 {
@@ -546,6 +604,33 @@
 		interrupt-parent = <&gic>;
 		system-power-controller;
 	};
+
+	wm1811: codec@1a {
+		compatible = "wlf,wm1811", "wlf,wm8994";
+		reg = <0x1a>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&codec_pins>;
+
+		AVDD2-supply = <&reg_vbatt>;
+		CPVDD-supply = <&reg_vbatt>;
+		DBVDD1-supply = <&ldo5>;
+		DBVDD2-supply = <&ldo5>;
+		DBVDD3-supply = <&ldo5>;
+		SPKVDD1-supply = <&reg_vbatt>;
+		SPKVDD2-supply = <&reg_vbatt>;
+
+		wlf,ldo1ena = <&gpio2 13 GPIO_ACTIVE_HIGH>;
+		wlf,ldoena-always-driven;
+		#sound-dai-cells = <1>;
+	};
+};
+
+&mcbsp3 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&mcbsp3_pins>;
+	#sound-dai-cells = <0>;
 };
 
 #include "twl6032.dtsi"
-- 
2.45.0
