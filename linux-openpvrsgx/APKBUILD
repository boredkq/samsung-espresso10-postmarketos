# PVRports kernel for OMAP4/PowerVR SGX540 devices.
# Sources are pinned to immutable upstream commits so GitHub Actions can build
# the kernel without keeping a second full kernel tree in this repository.
maintainer="Mighty <mightymb17@gmail.com>"
pkgname=linux-openpvrsgx
pkgver=6.1.0
pkgrel=4
pkgdesc="Mainline OMAP kernel with the PowerVR SGX pvrsrvkm driver"
arch="armv7"
_carch="arm"
_flavor="openpvrsgx"
url="https://github.com/tmlind/linux_openpvrsgx"
license="GPL-2.0-only"
options="!check !tracedeps pmb:cross-native pmb:kconfigcheck-community"
makedepends="openssl-dev yaml-dev mpc1-dev mpfr-dev xz findutils bison flex perl sed bash gmp-dev bc linux-headers elfutils-dev"

_kernel_commit="7c72e56fd0a27f87a2f5716a799f6f9d9005c016"
_pvrports_commit="b7ee11fd954428eec3871870a784dc144ea5c5c4"
_pvrports_raw="https://gitlab.com/pvrports/pvrports/-/raw/$_pvrports_commit/community/linux-openpvrsgx"
_config="config-$_flavor.$arch"

source="
	$pkgname-$_kernel_commit.tar.gz::https://github.com/tmlind/linux_openpvrsgx/archive/$_kernel_commit.tar.gz
	$_config::$_pvrports_raw/$_config
	0001-arm-dts-Add-TWL6032-dtsi.patch::$_pvrports_raw/0001-arm-dts-Add-TWL6032-dtsi.patch
	0002-arm-dts-Add-common-dtsi-for-espresso.patch::$_pvrports_raw/0002-arm-dts-Add-common-dtsi-for-espresso.patch
	0003-arm-dts-Add-espresso7-support.patch::$_pvrports_raw/0003-arm-dts-Add-espresso7-support.patch
	0004-arm-dts-Add-espresso10-support.patch::$_pvrports_raw/0004-arm-dts-Add-espresso10-support.patch
	0005-Add-TWL6030-power-driver-with-minimal-support-for-po.patch::$_pvrports_raw/0005-Add-TWL6030-power-driver-with-minimal-support-for-po.patch
	0006-Add-TWL6030-power-button-support-to-twl-pwrbutton.patch::$_pvrports_raw/0006-Add-TWL6030-power-button-support-to-twl-pwrbutton.patch
	0007-mfd-add-STMPE811-ADC-only-driver.patch::$_pvrports_raw/0007-mfd-add-STMPE811-ADC-only-driver.patch
	0008-Add-clk32kg-to-twl6030.patch::$_pvrports_raw/0008-Add-clk32kg-to-twl6030.patch
	0009-drivers-power-Add-support-for-smb136-charger.patch::$_pvrports_raw/0009-drivers-power-Add-support-for-smb136-charger.patch
	0010-Revert-partially-Revert-usb-musb-Set-the-DT-node-on-the-child-device.patch::$_pvrports_raw/0010-Revert-partially-Revert-usb-musb-Set-the-DT-node-on-the-child-device.patch
	0011-ata-ahci-fix-enum-constants-for-gcc-13.patch::$_pvrports_raw/0011-ata-ahci-fix-enum-constants-for-gcc-13.patch
	0012-arm-dts-espresso-add-wm1811-audio.patch
	0013-ASoC-ti-add-espresso-machine-driver.patch
	config-audio.fragment
"
builddir="$srcdir/linux_openpvrsgx-$_kernel_commit"
provides="linux-postmarketos-omap linux-samsung-espresso3g"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
	scripts/kconfig/merge_config.sh -m .config "$srcdir/config-audio.fragment"
	make ARCH="$_carch" olddefconfig
}

build() {
	unset LDFLAGS
	make V=1 ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"
}

package() {
	install -Dm644 "$builddir/arch/$_carch/boot/"*zImage \
		"$pkgdir/boot/vmlinuz"
	install -D "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
	make modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_DTBS_PATH="$pkgdir/usr/share/dtb"

	# A PVR kernel without pvrsrvkm is unusable and must not be published.
	find "$pkgdir" -type f -name 'pvrsrvkm_omap4_sgx540_120.ko*' -print -quit | grep -q . || {
		echo "ERROR: pvrsrvkm kernel module was not built" >&2
		return 1
	}

	# Do not publish an image that only contains userspace audio profiles.
	# All layers required to expose the WM1811 ALSA card must be present.
	for module in \
		'wm8994.ko*' \
		'wm8994-regulator.ko*' \
		'snd-soc-wm8994.ko*' \
		'snd-soc-espresso.ko*'; do
		find "$pkgdir" -type f -name "$module" -print -quit | grep -q . || {
			echo "ERROR: required audio module $module was not built" >&2
			return 1
		}
	done
}

