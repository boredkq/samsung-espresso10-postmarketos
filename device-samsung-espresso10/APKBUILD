# Reference: <https://postmarketos.org/devicepkg>
maintainer="Mithil Bavishi <bavishimithil@gmail.com>"
pkgname=device-samsung-espresso10
pkgdesc="Samsung Galaxy Tab 2 (10.1 inch)"
pkgver=8
pkgrel=5
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
replaces="upower"
depends="
	firmware-samsung-espresso
	linux-firmware-brcm
	linux-postmarketos-omap
	mkbootimg
	upower
	alsa-ucm-conf
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	espresso10-sound.conf
	HiFi.conf
	UPower.conf
	espresso-env.sh
	10-omapdrm.conf
	brcmfmac4330-sdio.txt
	brcmfmac4330-sdio.samsung,espresso10.txt
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# ALSA UCM2 audio configuration
	install -Dm644 "$srcdir"/espresso10-sound.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/espresso10-sound/espresso10-sound.conf
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/omap/espresso10-sound/HiFi.conf

	# Battery protection (prevent 0% discharge bootloop)
	install -Dm644 "$srcdir"/UPower.conf \
		"$pkgdir"/etc/UPower/UPower.conf

	# 2D/Software GL rendering optimizations
	install -Dm755 "$srcdir"/espresso-env.sh \
		"$pkgdir"/etc/profile.d/espresso.sh

	# Force 24-bit TrueColor depth in X11 to eliminate green tint & artifacts on OMAP4430
	install -Dm644 "$srcdir"/10-omapdrm.conf \
		"$pkgdir"/etc/X11/xorg.conf.d/10-omapdrm.conf

	# Broadcom BCM4330 SDIO WiFi NVRAM calibration files
	install -Dm644 "$srcdir"/brcmfmac4330-sdio.txt \
		"$pkgdir"/lib/firmware/brcm/brcmfmac4330-sdio.txt
	install -Dm644 "$srcdir"/brcmfmac4330-sdio.samsung,espresso10.txt \
		"$pkgdir"/lib/firmware/brcm/brcmfmac4330-sdio.samsung,espresso10.txt
}

