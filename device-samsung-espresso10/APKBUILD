# Reference: <https://postmarketos.org/devicepkg>
maintainer="Mithil Bavishi <bavishimithil@gmail.com>"
pkgname=device-samsung-espresso10
pkgdesc="Samsung Galaxy Tab 2 (10.1 inch)"
pkgver=8
pkgrel=12
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
replaces="upower"
depends="
	firmware-samsung-espresso
	linux-openpvrsgx
	mkbootimg
	upower
	alsa-ucm-conf
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	espresso10-sound.conf
	HiFi.conf
	UPower.conf
	espresso-env.sh
	10-omapdrm.conf
	weston.ini
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# ALSA UCM2 audio configuration
	install -Dm644 "$srcdir"/espresso10-sound.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/espresso10-sound/espresso10-sound.conf
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/omap/espresso10-sound/HiFi.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d "$pkgdir"/usr/share/alsa/ucm2/omap
	ln -s espresso10-sound "$pkgdir"/usr/share/alsa/ucm2/conf.d/espresso10-soun
	ln -s espresso10-sound.conf "$pkgdir"/usr/share/alsa/ucm2/conf.d/espresso10-sound/espresso10-soun.conf
	ln -s espresso10-sound "$pkgdir"/usr/share/alsa/ucm2/omap/espresso10-soun

	# Device-specific Weston configuration (use-pixman for reliable KMS display)
	install -Dm644 "$srcdir"/weston.ini \
		"$pkgdir"/etc/xdg/weston/weston.ini

	# Battery protection (prevent 0% discharge bootloop)
	install -Dm644 "$srcdir"/UPower.conf \
		"$pkgdir"/etc/UPower/UPower.conf

	# 2D/Software GL rendering optimizations
	install -Dm755 "$srcdir"/espresso-env.sh \
		"$pkgdir"/etc/profile.d/espresso.sh
	install -Dm755 "$srcdir"/espresso-env.sh \
		"$pkgdir"/etc/tinydm.d/env-wayland.d/20-espresso-pvr.sh

	# Force 24-bit TrueColor depth in X11 to eliminate green tint & artifacts on OMAP4430
	install -Dm644 "$srcdir"/10-omapdrm.conf \
		"$pkgdir"/etc/X11/xorg.conf.d/10-omapdrm.conf

	# firmware-samsung-espresso keeps redistributable blobs in the
	# postmarketos namespace.  brcmfmac's default lookup uses firmware/brcm,
	# so provide the board-specific names expected by the driver.
	mkdir -p "$pkgdir"/usr/lib/firmware/brcm
	ln -s ../postmarketos/brcm/brcmfmac4330-sdio.bin \
		"$pkgdir"/usr/lib/firmware/brcm/brcmfmac4330-sdio.bin
	ln -s ../postmarketos/brcm/brcmfmac4330-sdio.bin \
		"$pkgdir"/usr/lib/firmware/brcm/brcmfmac4330-sdio.samsung,espresso10.bin
	ln -s ../postmarketos/brcm/brcmfmac4330-sdio.samsung,espresso10.txt \
		"$pkgdir"/usr/lib/firmware/brcm/brcmfmac4330-sdio.samsung,espresso10.txt

}

